# Copy this to .env.local and fill in your own keys (never commit .env.local).

# --- Google (Gemini Live voice + background brain) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=<redacted>

# --- LiveKit (voice transport) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=<redacted>
LIVEKIT_API_SECRET=<redacted>

# --- Voice (Gemini Live speech-to-speech; defaults shown) ---
# YAADHAMMA_REALTIME_MODEL=gemini-3.8-live
# YAADHAMMA_REALTIME_VOICE=Sulafat
# YAADHAMMA_REALTIME_LANGUAGE=      # empty = let Gemini detect (English/Telugu mix)
# YAADHAMMA_END_OF_SPEECH_MS=800    # pause before Gemini decides he finished
# YAADHAMMA_CONTEXT_TRIGGER_TOKENS=16000  # start compressing the conversation here
# YAADHAMMA_CONTEXT_TARGET_TOKENS=8000    # ...down to this size
# YAADHAMMA_LOCAL_VAD=on            # on-device voice detector for reply timing

# --- Background brain (defaults shown; override only if you know why) ---
# YAADHAMMA_BRAIN_MODEL=gemini-3.5-flash-lite
# YAADHAMMA_ESCALATION_MODEL=gemini-3.8-flash
# YAADHAMMA_ESCALATION_EFFORT=high

# --- WhatsApp ---
# Chats Jeevan wants eyes on (case-insensitive "name contains"), comma-separated.
# YAADHAMMA_WHATSAPP_WATCHLIST=Saayam,SC1,SC2,SC3
# His own "(You)" chat, found by its phone digits (digest delivery target).
# YAADHAMMA_SELF_CHAT_NUMBER=

# --- Email ---
# Words that pull a mail out of Gmail's Promotions/Social tabs into the digest.
# YAADHAMMA_EMAIL_KEYWORDS=job,jobs,interview,recruiter,recruiting,hiring,job offer,application,applied,position,opportunity,Saayam
# YAADHAMMA_EMAIL_UNREAD_ONLY=       # set to 1 to include only unread mail in digests

# --- File tidy ---
# propose = write a plan for review and move nothing; apply = also move files.
# YAADHAMMA_TIDY_MODE=propose

# --- Budget ---
# Monthly model-spend budget, USD. The morning brief says so loudly past this;
# calls are never blocked.
# YAADHAMMA_MONTHLY_BUDGET_USD=35
