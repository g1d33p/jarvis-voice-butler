# --- LiveKit (voice transport + Inference TTS) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=<redacted>
LIVEKIT_API_SECRET=<redacted>

# --- Meta Model API (brain + STT) ---
# Create a key in the Meta developer console and put it in .env.local
# (never commit a real key). Without it, Yaadhamma falls back to the
# Gemini Live realtime voice path with a loud warning.
YAADHAMMA_MODEL_API_KEY=<your-meta-model-api-key>
# Base URL for the OpenAI-compatible Meta Model API. Leave as-is normally.
YAADHAMMA_MODEL_API_URL=https://api.meta.ai/v1

# --- Voice stack selection ---
# pipeline (default): Muse Spark thinks, Voice Transcribe listens,
# LiveKit Inference speaks. realtime: Gemini Live does everything.
YAADHAMMA_VOICE_MODE=pipeline

# --- Model choices (defaults shown; override only if you know why) ---
YAADHAMMA_BRAIN_MODEL=muse-spark-1.3
YAADHAMMA_VOICE_MODEL=muse-spark-1.3
YAADHAMMA_STT_MODEL=muse-voice-transcribe-1.0
# PUSH_TO_TALK | ENDPOINTING | DIARIZATION (default lets the model end turns)
YAADHAMMA_STT_MODE=ENDPOINTING
YAADHAMMA_ESCALATION_MODEL=muse-spark-1.3
YAADHAMMA_ESCALATION_EFFORT=high
# LiveKit Inference TTS voice (feminine placeholder - swap for Jeevan's pick)
YAADHAMMA_TTS_MODEL=fishaudio/s2.1-pro
YAADHAMMA_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# --- Runtime LLM failover (pipeline mode only) ---
# If the Meta endpoint hangs mid-conversation, the turn is re-issued against
# a Gemini text model instead of retrying the dead endpoint. STT/TTS are
# untouched, so the voice stays Sarah. Needs a Gemini API key:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional tuning (defaults shown):
# YAADHAMMA_FAILOVER_THRESHOLD=2   # consecutive Meta failures before the circuit opens
# YAADHAMMA_FAILOVER_TIMEOUT=5.0   # seconds per attempt before trying Gemini
# YAADHAMMA_FAILOVER_MODEL=gemini-3.8-flash  # (default; 2.5-flash was retired 2026-09-24)
# YAADHAMMA_FORCE_FAILOVER=1       # test switch: route the next turn to Gemini
